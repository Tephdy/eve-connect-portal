// @@CONTRACT_ENGINE:reservation-attach
import "server-only";
import { createAdminClient } from "@/lib/supabase/admin";
import { buildReservationContext } from "./reservation-context";
import { renderContractContext } from "./render";
import { code128Svg } from "./barcode";

/**
 * Render + upsert the reservation contract for a given reservation id.
 * Non-fatal: returns null and logs on failure.
 */
export async function renderReservationContract(
  reservationId: string
): Promise<{ contract_id: string; template_id: string; body_length: number } | null> {
  const admin = createAdminClient();

  try {
    const { data: template } = await admin
      .schema("prep")
      .from("contract_template")
      .select("id, body_markdown")
      .eq("doc_type", "reservation")
      .eq("active", true)
      .order("version", { ascending: false })
      .limit(1)
      .maybeSingle();

    if (!template) {
      console.warn("[renderReservationContract] No active reservation template");
      return null;
    }

    const ctx = await buildReservationContext(reservationId);
    // Reuse the strict renderer via a cast (ReservationContext is a superset)
    let rendered = renderContractContext(
      template.body_markdown,
      ctx as unknown as Parameters<typeof renderContractContext>[1],
      { escape: false }
    );

    // Inject barcode if the template references {{barcode}}
    try {
      const barcodeSvg = code128Svg(`RSV-${reservationId.slice(0, 8).toUpperCase()}`, {
        height: 40,
        scale: 2,
      });
      rendered = rendered.replace(
        /<p class="barcode-placeholder">[\s\S]*?<\/p>/,
        `<div class="barcode-placeholder">${barcodeSvg}</div>`
      );
    } catch {
      // barcode optional
    }

    // Upsert
    const { data: existing } = await admin
      .schema("prep")
      .from("reservation_contract")
      .select("id")
      .eq("reservation_id", reservationId)
      .limit(1)
      .maybeSingle();

    if (existing) {
      const { error: upErr } = await admin
        .schema("prep")
        .from("reservation_contract")
        .update({
          template_id: template.id,
          generated_body: rendered,
        })
        .eq("id", existing.id);
      if (upErr) throw new Error("update failed: " + upErr.message);
      return {
        contract_id: existing.id,
        template_id: template.id,
        body_length: rendered.length,
      };
    }

    const { data: inserted, error: insErr } = await admin
      .schema("prep")
      .from("reservation_contract")
      .insert({
        reservation_id: reservationId,
        template_id: template.id,
        generated_body: rendered,
        status: "draft",
      })
      .select("id")
      .single();
    if (insErr) throw new Error("insert failed: " + insErr.message);

    return {
      contract_id: inserted.id,
      template_id: template.id,
      body_length: rendered.length,
    };
  } catch (err) {
    console.error(
      "[renderReservationContract]",
      err instanceof Error ? err.message : err
    );
    return null;
  }
}
