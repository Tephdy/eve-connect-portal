"use client";

import { useState } from "react";
import Link from "next/link";
import { usePathname } from "next/navigation";
import { Home, FileText, LogOut, X, User } from "lucide-react";
import { cn } from "@/lib/utils/cn";

const NAV = [
  { href: "/portal",         label: "Home",    icon: Home },
  { href: "/portal/lease",   label: "Lease",   icon: FileText },
  { href: "/portal/profile", label: "Profile", icon: User },
];

export function PortalShell({
  email,
  children,
}: {
  email: string;
  children: React.ReactNode;
}) {
  const pathname = usePathname();
  const [menuOpen, setMenuOpen] = useState(false);

  const initial = email.trim().charAt(0).toUpperCase() || "?";
  const isActive = (href: string) =>
    href === "/portal" ? pathname === "/portal" : pathname.startsWith(href);

  return (
    <div className="h-screen overflow-y-auto bg-ink-50/60 dark:bg-[#0a0b0f]">
      <header className="sticky top-0 z-30 border-b border-ink-200/70 bg-white/85 backdrop-blur-md dark:border-white/[0.06] dark:bg-[#111318]/85">
        <div className="mx-auto flex h-14 max-w-5xl items-center justify-between px-4">
          <Link href="/portal" className="flex items-center gap-2.5">
            <div className="flex h-8 w-8 items-center justify-center rounded-xl bg-brand-gradient shadow-glow-sm">
              <span className="text-xs font-bold text-white">E</span>
            </div>
            <span className="text-[15px] font-semibold tracking-tight text-ink-900">
              Eve&apos;s Residences
            </span>
          </Link>

          <button
            type="button"
            onClick={() => setMenuOpen(true)}
            aria-label="Open account menu"
            className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-500 text-sm font-semibold text-white transition-transform hover:scale-105 active:scale-95"
          >
            {initial}
          </button>
        </div>
      </header>

      <main className="mx-auto max-w-5xl px-4 py-6 pb-28">{children}</main>

      <nav
        className="fixed inset-x-0 bottom-0 z-30 border-t border-ink-200/70 bg-white/90 backdrop-blur-md dark:border-white/[0.06] dark:bg-[#111318]/90"
        style={{ paddingBottom: "env(safe-area-inset-bottom)" }}
      >
        <div className="mx-auto flex max-w-5xl items-stretch justify-around px-2">
          {NAV.map((item) => {
            const Icon = item.icon;
            const active = isActive(item.href);
            return (
              <Link
                key={item.href}
                href={item.href}
                className={cn(
                  "flex flex-1 flex-col items-center gap-0.5 py-2.5 text-[10px] font-medium transition-colors",
                  active
                    ? "text-brand-600 dark:text-brand-400"
                    : "text-ink-500 hover:text-ink-800 dark:hover:text-ink-200"
                )}
              >
                <span
                  className={cn(
                    "flex h-8 w-12 items-center justify-center rounded-full transition-all",
                    active && "bg-brand-500/10 dark:bg-brand-500/15"
                  )}
                >
                  <Icon className="h-[18px] w-[18px]" strokeWidth={active ? 2.5 : 2} />
                </span>
                {item.label}
              </Link>
            );
          })}
        </div>
      </nav>

      {menuOpen && (
        <div
          className="fixed inset-0 z-40 bg-black/30 backdrop-blur-sm"
          onClick={() => setMenuOpen(false)}
        >
          <div
            className="absolute inset-x-4 top-16 mx-auto max-w-sm overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-xl dark:border-white/[0.08] dark:bg-[#16181e]"
            onClick={(e) => e.stopPropagation()}
          >
            <div className="flex items-start justify-between gap-3 p-4">
              <div className="min-w-0">
                <p className="text-xs font-medium uppercase tracking-wide text-ink-400">
                  Signed in as
                </p>
                <p className="mt-0.5 truncate text-sm font-medium text-ink-900">
                  {email}
                </p>
              </div>
              <button
                type="button"
                onClick={() => setMenuOpen(false)}
                className="rounded-lg p-1 text-ink-400 hover:bg-ink-100 dark:hover:bg-white/[0.06]"
                aria-label="Close menu"
              >
                <X className="h-4 w-4" />
              </button>
            </div>

            <form action="/portal/logout" method="post" className="border-t border-ink-100 dark:border-white/[0.06]">
              <button
                type="submit"
                className="flex w-full items-center gap-3 px-4 py-3 text-sm font-medium text-danger-600 transition-colors hover:bg-danger-500/5 dark:text-danger-500"
              >
                <LogOut className="h-4 w-4" />
                Sign out
              </button>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
